{
  "name": "@fullcalendar/lwc-scheduler",
  "version": "7.1.4",
  "private": true,
  "title": "FullCalendar Scheduler LWC",
  "description": "Salesforce Lightning Web Component wrapper for FullCalendar Scheduler",
  "type": "module",
  "scripts": {
    "archive": "./scripts/archive.ts",
    "build": "./scripts/build.ts",
    "clean": "rm -rf dist archives",
    "smoke:login": "sf org login web --set-default --alias fullcalendar-dev",
    "smoke:orgs": "sf org list",
    "smoke:deploy": "cd dist && sf project deploy start --source-dir force-app --target-org fullcalendar-dev"
  },
  "dependencies": {
    "@fullcalendar/lwc": "workspace:7.1.4",
    "fullcalendar": "workspace:7.1.4",
    "fullcalendar-scheduler": "workspace:7.1.4"
  },
  "devDependencies": {
    "@salesforce/cli": "^2.112.6",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.5.2",
    "archiver": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
